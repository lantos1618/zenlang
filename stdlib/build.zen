// Parse-only placeholder for @std.build.
// Promote build APIs only after parser, typechecker, lowering, and docs-truth evidence.

{ Builder, BuildConfig, BuildError, Library } = @builtin.build

build = (b: Builder) Result<BuildConfig, BuildError> {
    b.add(Library { name: "std", exports: ["compiler.zen"] })
    .Ok(b.config())
}
