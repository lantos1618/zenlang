// A concrete i64 future pool: collect `Future<i64>` handles, then drain them all
// to completion, accumulating the running total of their values.
//
//   { Pool, pool, submit, drain } = std.memory.async_pool
//
// Now that `Future<T>` is a nameable type, the pool is ordinary typed Zen: its
// queue is a `Vec<Future<i64>>` and `drain` drives each entry via the stdlib
// `block_on`. All `Vec` operations stay in non-generic functions so the `Vec`
// specialization never lands inside a generic body.

{ block_on } = std.concurrency.async.future
{ Vec, vec_new_default, vec_push, vec_get, vec_len } = std.collections.vec

// A pool of pending i64 futures.
Pool: { futures: Vec<Future<i64>> }

// Create a fresh, empty pool.
pool = () Pool {
    Pool { futures: vec_new_default<Future<i64>>() }
}

// Submit a future to the pool; returns the pool with it enqueued.
submit = (p: Pool, f: Future<i64>) Pool {
    Pool { futures: vec_push(p.futures, f) }
}

// Drive every submitted future to completion, returning the sum of their values.
drain = (p: Pool) i64 {
    n = vec_len(p.futures)
    total ::= cast(0, i64)
    i ::= cast(0, i64)
    loop((l) {
        i >= n ?
            | true { l.done() }
            | false {
                total = total + block_on<i64>(vec_get(p.futures, i))
                i = i + 1
                l.next()
            }
    })
    total
}

@export({ Pool, pool, submit, drain })
