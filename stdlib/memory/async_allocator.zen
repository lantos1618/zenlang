// Zen Standard Library: Async Helpers
// ============================================================================
// Shared utilities for async allocators (ArenaAsync, future HeapAsync, etc.)
// ============================================================================

{ compiler } = @std
{ Allocator, ExecutionMode, CompletionFn } = @std.memory.allocator

// ============================================================================
// Async Operation Tracking
// ============================================================================

AsyncOp: {
    id: u64,
    user_data: u64,
    callback: CompletionFn,
    status: i32  // 0=pending, 1=complete, negative=error
}

OP_PENDING: i32 = 0
OP_COMPLETE: i32 = 1

async_op_new = (id: u64, user_data: u64, callback: CompletionFn) AsyncOp {
    AsyncOp {
        id: id,
        user_data: user_data,
        callback: callback,
        status: OP_PENDING
    }
}

async_op_is_pending = (op: AsyncOp) bool {
    op.status == OP_PENDING
}

async_op_is_complete = (op: AsyncOp) bool {
    op.status == OP_COMPLETE
}

async_op_is_error = (op: AsyncOp) bool {
    op.status < 0
}
