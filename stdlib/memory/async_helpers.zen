// Zen Standard Library: Async Operation Helpers

{ CompletionFn } = @std.memory.allocator

// ============================================================================
// Shared Async Operation State
// ============================================================================

AsyncOperationState:
    Pending,
    Completed,
    Failed

AsyncOp: {
    id: u64,
    user_data: u64,
    callback: CompletionFn,
    state: AsyncOperationState,
    result: i64
}

async_op_new = (id: u64, user_data: u64, callback: CompletionFn) AsyncOp {
    AsyncOp {
        id: id,
        user_data: user_data,
        callback: callback,
        state: AsyncOperationState.Pending,
        result: 0
    }
}

async_op_completed = (op: AsyncOp, result: i64) AsyncOp {
    AsyncOp {
        id: op.id,
        user_data: op.user_data,
        callback: op.callback,
        state: AsyncOperationState.Completed,
        result: result
    }
}

async_op_failed = (op: AsyncOp, result: i64) AsyncOp {
    AsyncOp {
        id: op.id,
        user_data: op.user_data,
        callback: op.callback,
        state: AsyncOperationState.Failed,
        result: result
    }
}

async_op_is_pending = (op: AsyncOp) bool {
    op.state == AsyncOperationState.Pending
}

async_op_is_complete = (op: AsyncOp) bool {
    op.state == AsyncOperationState.Completed
}

async_op_is_error = (op: AsyncOp) bool {
    op.state == AsyncOperationState.Failed
}

// ============================================================================
// Completion Promise
// ============================================================================

Promise: {
    state: AsyncOperationState,
    result: i64,
    user_data: u64
}

Promise.new = () Promise {
    Promise {
        state: AsyncOperationState.Pending,
        result: 0,
        user_data: 0
    }
}

Promise.new_with_data = (data: u64) Promise {
    Promise {
        state: AsyncOperationState.Pending,
        result: 0,
        user_data: data
    }
}

Promise.is_pending = (self: Promise) bool {
    self.state == AsyncOperationState.Pending
}

Promise.is_completed = (self: Promise) bool {
    self.state == AsyncOperationState.Completed
}

Promise.is_failed = (self: Promise) bool {
    self.state == AsyncOperationState.Failed
}

Promise.get_result = (self: Promise) i64 {
    self.result
}
