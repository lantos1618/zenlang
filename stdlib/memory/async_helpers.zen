// Concrete i64 future helpers — small combinators over `Future<i64>`.
//
//   { await_now, sum2 } = std.memory.async_helpers
//
// These exist to drive `@async` results without spinning up a scheduler. They
// are ordinary typed Zen now that `Future<T>` is a nameable type: each takes a
// `Future<i64>` in its signature and drives it via the stdlib `block_on`.

{ block_on } = std.concurrency.async.future

// Drive a single i64 future to its value (block_on, specialized to i64).
await_now = (f: Future<i64>) i64 {
    block_on<i64>(f)
}

// Drive two i64 futures to completion and return the sum of their values.
sum2 = (a: Future<i64>, b: Future<i64>) i64 {
    block_on<i64>(a) + block_on<i64>(b)
}

@export({ await_now, sum2 })
