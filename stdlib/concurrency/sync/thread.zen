// A thin Thread wrapper over pthread_create/pthread_join.
// `Thread` holds the 8-byte pthread_t value stored in a heap cell.
// The start routine must be a `(RawPtr<u8>) RawPtr<u8>` function.
//   { Thread, thread_spawn, thread_join, thread_free }
//     = std.concurrency.sync.thread

@extern pthread_create = (thread: RawPtr<u8>, attr: RawPtr<u8>, start: (RawPtr<u8>) RawPtr<u8>, arg: RawPtr<u8>) i32
@extern pthread_join = (thread: i64, retval: RawPtr<u8>) i32

// A heap cell holding a pthread_t (8 bytes on x86-64 Linux).
Thread: { ptr: RawPtr<u8> }

// Spawn a new thread running `start(arg)`. Returns the Thread handle.
thread_spawn = (start: (RawPtr<u8>) RawPtr<u8>, arg: RawPtr<u8>) Thread {
    ptr = @builtin.raw_allocate(cast(8, usize))
    pthread_create(ptr, @builtin.null_ptr(), start, arg)
    Thread { ptr: ptr }
}

// Block until the thread finishes. The thread's return value is discarded.
thread_join = (t: Thread) void {
    tid = @builtin.load<i64>(t.ptr)
    pthread_join(tid, @builtin.null_ptr())
}

// Free the Thread handle (call after thread_join).
thread_free = (t: Thread) void {
    @builtin.raw_deallocate(t.ptr, cast(8, usize))
}

@export({ Thread, thread_spawn, thread_join, thread_free })
