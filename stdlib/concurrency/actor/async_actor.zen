// A concrete single-threaded async actor over i64 state.
//
//   { AsyncActor, async_actor, async_actor_feed, async_actor_state } =
//       std.concurrency.actor.async_actor
//
// The actor owns one i64 of state in a heap cell. A message is delivered as a
// `Future<i64>` — typically an `@async` handler call that computes the i64 to
// fold into the state. `async_actor_feed` drives that future to completion (via
// the stdlib `block_on`) and adds its value into the state cell. This is
// expressible only because `Future<i64>` is now a nameable type in a signature.

{ block_on } = std.concurrency.async.future

// An async actor: a heap cell holding the running i64 state.
AsyncActor: { state: RawPtr<u8> }

// Create a fresh actor with state initialised to 0.
async_actor = () AsyncActor {
    cell = @builtin.raw_allocate(cast(8, usize))
    @builtin.store(cell, cast(0, i64))
    AsyncActor { state: cell }
}

// Deliver one message (an i64-producing future): drive it to completion and fold
// its value into the actor's state. Returns the new state.
async_actor_feed = (a: AsyncActor, msg: Future<i64>) i64 {
    v = block_on<i64>(msg)
    prev = @builtin.load<i64>(a.state)
    next = prev + v
    @builtin.store(a.state, next)
    next
}

// Read the actor's current accumulated state.
async_actor_state = (a: AsyncActor) i64 {
    @builtin.load<i64>(a.state)
}

@export({ AsyncActor, async_actor, async_actor_feed, async_actor_state })
