// Zen Standard Library: System Info (Syscall-based)
// No FFI - uses compiler.syscall* intrinsics

{ compiler } = @std
{ Result } = @std.core.result
{ SYS_UNAME, SYS_GETUID, SYS_GETGID, SYS_GETEUID, SYS_GETEGID } = @std.sys.syscall

SysError: { code: i32 }

SysError.from_errno = (errno: i64) SysError {
    SysError { code: cast(0 - errno, i32) }
}

// Get user ID
getuid = () u32 {
    cast(compiler.syscall0(SYS_GETUID), u32)
}

// Get group ID
getgid = () u32 {
    cast(compiler.syscall0(SYS_GETGID), u32)
}

// Get effective user ID
geteuid = () u32 {
    cast(compiler.syscall0(SYS_GETEUID), u32)
}

// Get effective group ID
getegid = () u32 {
    cast(compiler.syscall0(SYS_GETEGID), u32)
}

// Check if running as root
is_root = () bool {
    geteuid() == 0
}
