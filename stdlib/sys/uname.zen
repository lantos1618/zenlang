// uname syscall (syscall 63) — x86-64 Linux.
// The utsname struct is 6 fields × 65 bytes = 390 bytes.
// sysname starts at offset 0; a non-zero first byte proves the call worked.
//   { uname_ok, uname_sysname_first } = std.sys.uname

{ sys1, raw_allocate, raw_deallocate, ptr_to_int, load_u8 } = std.compiler

// Returns true if the uname syscall succeeds (returns 0).
uname_ok = () bool {
    buf = raw_allocate(cast(390, usize))
    addr = ptr_to_int(buf)
    ret = sys1(63, addr)
    raw_deallocate(buf, cast(390, usize))
    ret == 0
}

// Returns the first byte of the sysname field (should be non-zero on any Linux).
uname_sysname_first = () u8 {
    buf = raw_allocate(cast(390, usize))
    addr = ptr_to_int(buf)
    sys1(63, addr)
    b = load_u8(buf)
    raw_deallocate(buf, cast(390, usize))
    b
}

@export({ uname_ok, uname_sysname_first })
