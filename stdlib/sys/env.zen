// Environment variable lookup via libc `getenv` (FFI, not a syscall — the kernel
// passes the environment on the initial stack and libc exposes it; linked from
// libc by default). Returns a raw C-string pointer, or null when unset.
//   { env_get, env_has } = std.sys.env

// libc getenv takes a `const char*`; we pass the StaticString's data pointer
// explicitly (the @extern auto-marshal only applies to string *literals*, not a
// StaticString passed as a value).
@extern getenv = (name: RawPtr<u8>) RawPtr<u8>

// The raw value pointer for `name`; null when the variable is unset.
env_get = (name: StaticString) RawPtr<u8> {
    getenv(@builtin.static_string_ptr(name))
}

// Whether `name` is present in the environment.
env_has = (name: StaticString) bool {
    @builtin.is_null(getenv(@builtin.static_string_ptr(name))) ?
        | true { false }
        | false { true }
}

@export({ env_get, env_has })
