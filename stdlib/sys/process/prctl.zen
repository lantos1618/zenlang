// Process control via prctl (syscall 157) — x86-64 Linux.
// Exposes prctl_set_name (PR_SET_NAME=15) and prctl_get_name (PR_GET_NAME=16).
//   { prctl_set_name, prctl_get_name } = std.sys.process.prctl
//
// Both ops take a 16-byte buffer for the process name (including NUL).

{ sys5, ptr_to_int } = std.compiler

// Set the calling thread's name to the null-terminated string at `name_ptr`.
// prctl(PR_SET_NAME=15, name_ptr, 0, 0, 0) — returns 0 on success.
prctl_set_name = (name_ptr: RawPtr<u8>) i64 {
    addr = ptr_to_int(name_ptr)
    sys5(157, 15, addr, 0, 0, 0)
}

// Read the calling thread's name into `buf` (must be >= 16 bytes).
// prctl(PR_GET_NAME=16, buf_ptr, 0, 0, 0) — returns 0 on success.
prctl_get_name = (buf: RawPtr<u8>) i64 {
    addr = ptr_to_int(buf)
    sys5(157, 16, addr, 0, 0, 0)
}

@export({ prctl_set_name, prctl_get_name })
