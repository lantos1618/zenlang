// Generic growable vector, allocator-backed. The allocation strategy is the
// `Alloc` type parameter (any `Allocator`) — system, arena, pool, … — instead
// of hardcoded malloc. Use `vec_new(allocator)`, or `vec_new_default()` for the
// system allocator.
//   { Vec, vec_new, vec_new_default, vec_push, vec_get, vec_len, vec_free } = std.collections.vec

{ Allocator, Mallocator, mallocator } = std.memory.allocator

Vec<T, Alloc: Allocator>: { data: RawPtr<u8>, len: i64, cap: i64, alloc: Alloc }

elem_size<T> = () i64 {
    cast(@builtin.sizeof<T>(), i64)
}

vec_new<T, Alloc: Allocator> = (alloc: Alloc) Vec<T, Alloc> {
    Vec<T, Alloc> {
        data: alloc.alloc(cast(elem_size<T>() * 4, usize)),
        len: 0,
        cap: 4,
        alloc: alloc,
    }
}

// Convenience: a Vec on the default system allocator.
vec_new_default<T> = () Vec<T, Mallocator> {
    vec_new<T, Mallocator>(mallocator())
}

vec_len<T, Alloc: Allocator> = (v: Vec<T, Alloc>) i64 {
    v.len
}

vec_get<T, Alloc: Allocator> = (v: Vec<T, Alloc>, index: i64) T {
    @builtin.load<T>(@builtin.gep(v.data, index * elem_size<T>()))
}

vec_push<T, Alloc: Allocator> = (v: Vec<T, Alloc>, value: T) Vec<T, Alloc> {
    grown = v.len == v.cap ?
        | true {
            new_cap = v.cap * 2
            old_bytes = cast(v.cap * elem_size<T>(), usize)
            new_bytes = cast(new_cap * elem_size<T>(), usize)
            Vec<T, Alloc> {
                data: v.alloc.realloc(v.data, old_bytes, new_bytes),
                len: v.len,
                cap: new_cap,
                alloc: v.alloc,
            }
        }
        | false { v }
    @builtin.store(@builtin.gep(grown.data, grown.len * elem_size<T>()), value)
    Vec<T, Alloc> { data: grown.data, len: grown.len + 1, cap: grown.cap, alloc: grown.alloc }
}

vec_free<T, Alloc: Allocator> = (v: Vec<T, Alloc>) void {
    v.alloc.free(v.data, cast(v.cap * elem_size<T>(), usize))
}

@export({ Vec, vec_new, vec_new_default, vec_len, vec_get, vec_push, vec_free })
