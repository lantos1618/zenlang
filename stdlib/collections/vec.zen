// Generic growable vector, heap-backed via @builtin intrinsics.
// `{ Vec, vec_new, vec_push, vec_get, vec_len, vec_free } = std.collections.vec`

Vec<T>: { data: RawPtr<u8>, len: i64, cap: i64 }

elem_size<T> = () i64 {
    cast(@builtin.sizeof<T>(), i64)
}

vec_new<T> = () Vec<T> {
    Vec<T> {
        data: @builtin.raw_allocate(@builtin.sizeof<T>() * 4),
        len: 0,
        cap: 4,
    }
}

vec_len<T> = (v: Vec<T>) i64 {
    v.len
}

vec_get<T> = (v: Vec<T>, index: i64) T {
    @builtin.load<T>(@builtin.gep(v.data, index * elem_size<T>()))
}

vec_push<T> = (v: Vec<T>, value: T) Vec<T> {
    grown = v.len == v.cap ?
        | true {
            new_cap = v.cap * 2
            Vec<T> {
                data: @builtin.raw_reallocate(v.data, cast(v.cap * elem_size<T>(), usize), cast(new_cap * elem_size<T>(), usize)),
                len: v.len,
                cap: new_cap,
            }
        }
        | false { v }
    @builtin.store(@builtin.gep(grown.data, grown.len * elem_size<T>()), value)
    Vec<T> { data: grown.data, len: grown.len + 1, cap: grown.cap }
}

vec_free<T> = (v: Vec<T>) void {
    @builtin.raw_deallocate(v.data, cast(v.cap * elem_size<T>(), usize))
}

fold_from<T, A> = (v: Vec<T>, acc: A, f: (A, T) A, i: i64) A {
    i >= v.len ?
        | true { acc }
        | false { fold_from<T, A>(v, f(acc, vec_get<T>(v, i)), f, i + 1) }
}

// Left fold: combine every element into an accumulator with `f`.
vec_fold<T, A> = (v: Vec<T>, init: A, f: (A, T) A) A {
    fold_from<T, A>(v, init, f, 0)
}

map_from<T, U> = (v: Vec<T>, out: Vec<U>, f: (T) U, i: i64) Vec<U> {
    i >= v.len ?
        | true { out }
        | false { map_from<T, U>(v, vec_push<U>(out, f(vec_get<T>(v, i))), f, i + 1) }
}

// Produce a new vector applying `f` to each element.
vec_map<T, U> = (v: Vec<T>, f: (T) U) Vec<U> {
    map_from<T, U>(v, vec_new<U>(), f, 0)
}

@export({ Vec, vec_new, vec_len, vec_get, vec_push, vec_free, vec_fold, vec_map })
