// Generic growable vector, heap-backed via @builtin intrinsics.
// `{ Vec, vec_new, vec_push, vec_get, vec_len, vec_free } = std.collections.vec`

pub Vec<T>: { data: RawPtr<u8>, len: i64, cap: i64 }

elem_size<T> = () i64 {
    cast(@builtin.sizeof<T>(), i64)
}

pub vec_new<T> = () Vec<T> {
    Vec<T> {
        data: @builtin.raw_allocate(@builtin.sizeof<T>() * 4),
        len: 0,
        cap: 4,
    }
}

pub vec_len<T> = (v: Vec<T>) i64 {
    v.len
}

pub vec_get<T> = (v: Vec<T>, index: i64) T {
    @builtin.load<T>(@builtin.gep(v.data, index * elem_size<T>()))
}

pub vec_push<T> = (v: Vec<T>, value: T) Vec<T> {
    grown = v.len == v.cap ?
        | true {
            new_cap = v.cap * 2
            Vec<T> {
                data: @builtin.raw_reallocate(v.data, cast(v.cap * elem_size<T>(), usize), cast(new_cap * elem_size<T>(), usize)),
                len: v.len,
                cap: new_cap,
            }
        }
        | false { v }
    @builtin.store(@builtin.gep(grown.data, grown.len * elem_size<T>()), value)
    Vec<T> { data: grown.data, len: grown.len + 1, cap: grown.cap }
}

pub vec_free<T> = (v: Vec<T>) void {
    @builtin.raw_deallocate(v.data, cast(v.cap * elem_size<T>(), usize))
}
