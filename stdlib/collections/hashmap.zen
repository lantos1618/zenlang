// Separately-chained hash map keyed by a `Hashable` type. Each of the fixed
// `nbuckets` slots heads a chain of heap `Entry<K, V>` nodes; collisions and
// updates walk the chain with `Hashable.eq`. Lookups return `Option<V>`.
// (Fixed bucket count — no rehash/resize yet; load degrades gracefully.)
// `{ HashMap, hashmap_new, hashmap_put, hashmap_get, hashmap_len } = std.collections.hashmap`

{ Hashable } = std.core.cmp
{ Option } = std.core.option
{ raw_allocate, sizeof, sizeof_rawptr, gep, load, store, load_rawptr, store_rawptr, is_null, mem_set } = std.compiler

Entry<K, V>: { key: K, value: V, next: RawPtr<u8> }

HashMap<K: Hashable, V>: { buckets: RawPtr<u8>, nbuckets: i64, len: i64 }

ptr_slot = (i: i64) i64 {
    i * cast(sizeof_rawptr(), i64)
}

hashmap_new<K: Hashable, V> = () HashMap<K, V> {
    n ::= cast(8, i64)
    bytes ::= cast(ptr_slot(n), usize)
    b ::= raw_allocate(bytes)
    mem_set(b, cast(0, u8), bytes)
    HashMap<K, V> { buckets: b, nbuckets: n, len: 0 }
}

hashmap_len<K: Hashable, V> = (m: HashMap<K, V>) i64 {
    m.len
}

bucket_slot<K: Hashable, V> = (m: HashMap<K, V>, key: K) RawPtr<u8> {
    gep(m.buckets, ptr_slot(key.hash() & (m.nbuckets - 1)))
}

// Walk a chain, updating the value in place if the key is present.
// Returns true when an existing entry was updated.
update_chain<K: Hashable, V> = (ptr: RawPtr<u8>, key: K, value: V) bool {
    is_null(ptr) ?
        | true { false }
        | false {
            e ::= load<Entry<K, V>>(ptr)
            e.key.eq(key) ?
                | true {
                    store<Entry<K, V>>(ptr, Entry<K, V> { key: e.key, value: value, next: e.next })
                    true
                }
                | false { update_chain<K, V>(e.next, key, value) }
        }
}

hashmap_put<K: Hashable, V> = (m: HashMap<K, V>, key: K, value: V) HashMap<K, V> {
    slot ::= bucket_slot<K, V>(m, key)
    update_chain<K, V>(load_rawptr(slot), key, value) ?
        | true { m }
        | false {
            node ::= raw_allocate(sizeof<Entry<K, V>>())
            store<Entry<K, V>>(node, Entry<K, V> {
                key: key,
                value: value,
                next: load_rawptr(slot),
            })
            store_rawptr(slot, node)
            HashMap<K, V> { buckets: m.buckets, nbuckets: m.nbuckets, len: m.len + 1 }
        }
}

get_chain<K: Hashable, V> = (ptr: RawPtr<u8>, key: K) Option<V> {
    is_null(ptr) ?
        | true { Option<V>.None }
        | false {
            e ::= load<Entry<K, V>>(ptr)
            e.key.eq(key) ?
                | true { Option<V>.Some(e.value) }
                | false { get_chain<K, V>(e.next, key) }
        }
}

hashmap_get<K: Hashable, V> = (m: HashMap<K, V>, key: K) Option<V> {
    get_chain<K, V>(load_rawptr(bucket_slot<K, V>(m, key)), key)
}

@export({ Entry, HashMap, hashmap_new, hashmap_len, hashmap_put, hashmap_get })
