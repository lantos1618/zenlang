// Separately-chained hash map keyed by a `Hashable` type. Each of the fixed
// `nbuckets` slots heads a chain of heap `Entry<K, V>` nodes; collisions and
// updates walk the chain with `Hashable.eq`. Lookups return `Option<V>`.
// (Fixed bucket count — no rehash/resize yet; load degrades gracefully.)
// `{ HashMap, hashmap_new, hashmap_put, hashmap_get, hashmap_len } = std.collections.hashmap`

{ Hashable } = std.core.cmp
{ Option } = std.core.option

pub Entry<K, V>: { key: K, value: V, next: RawPtr<u8> }

pub HashMap<K: Hashable, V>: { buckets: RawPtr<u8>, nbuckets: i64, len: i64 }

ptr_slot = (i: i64) i64 {
    i * cast(@builtin.sizeof<RawPtr<u8>>(), i64)
}

pub hashmap_new<K: Hashable, V> = () HashMap<K, V> {
    n ::= cast(8, i64)
    bytes ::= cast(ptr_slot(n), usize)
    b ::= @builtin.raw_allocate(bytes)
    @builtin.memset(b, cast(0, u8), bytes)
    HashMap<K, V> { buckets: b, nbuckets: n, len: 0 }
}

pub hashmap_len<K: Hashable, V> = (m: HashMap<K, V>) i64 {
    m.len
}

bucket_slot<K: Hashable, V> = (m: HashMap<K, V>, key: K) RawPtr<u8> {
    @builtin.gep(m.buckets, ptr_slot(key.hash() & (m.nbuckets - 1)))
}

// Walk a chain, updating the value in place if the key is present.
// Returns true when an existing entry was updated.
update_chain<K: Hashable, V> = (ptr: RawPtr<u8>, key: K, value: V) bool {
    @builtin.is_null(ptr) ?
        | true { false }
        | false {
            e ::= @builtin.load<Entry<K, V>>(ptr)
            e.key.eq(key) ?
                | true {
                    @builtin.store(ptr, Entry<K, V> { key: e.key, value: value, next: e.next })
                    true
                }
                | false { update_chain<K, V>(e.next, key, value) }
        }
}

pub hashmap_put<K: Hashable, V> = (m: HashMap<K, V>, key: K, value: V) HashMap<K, V> {
    slot ::= bucket_slot<K, V>(m, key)
    update_chain<K, V>(@builtin.load<RawPtr<u8>>(slot), key, value) ?
        | true { m }
        | false {
            node ::= @builtin.raw_allocate(@builtin.sizeof<Entry<K, V>>())
            @builtin.store(node, Entry<K, V> {
                key: key,
                value: value,
                next: @builtin.load<RawPtr<u8>>(slot),
            })
            @builtin.store(slot, node)
            HashMap<K, V> { buckets: m.buckets, nbuckets: m.nbuckets, len: m.len + 1 }
        }
}

get_chain<K: Hashable, V> = (ptr: RawPtr<u8>, key: K) Option<V> {
    @builtin.is_null(ptr) ?
        | true { Option<V>.None }
        | false {
            e ::= @builtin.load<Entry<K, V>>(ptr)
            e.key.eq(key) ?
                | true { Option<V>.Some(e.value) }
                | false { get_chain<K, V>(e.next, key) }
        }
}

pub hashmap_get<K: Hashable, V> = (m: HashMap<K, V>, key: K) Option<V> {
    get_chain<K, V>(@builtin.load<RawPtr<u8>>(bucket_slot<K, V>(m, key)), key)
}
