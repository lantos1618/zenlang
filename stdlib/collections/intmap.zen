// Append-only i64->i64 map, heap-backed via std.compiler. Linear lookup (recursive).
// `{ IntMap, intmap_new, intmap_set, intmap_get, intmap_len, intmap_free } = std.collections.intmap

{ raw_allocate, raw_deallocate, raw_reallocate, gep, load_i64, store_i64 } = std.compiler

IntMap: { keys: RawPtr<u8>, vals: RawPtr<u8>, len: i64, cap: i64 }

slot = (n: i64) i64 { n * 8 }

intmap_new = () IntMap {
    IntMap {
        keys: raw_allocate(cast(slot(8), usize)),
        vals: raw_allocate(cast(slot(8), usize)),
        len: 0,
        cap: 8,
    }
}

intmap_len = (m: IntMap) i64 { m.len }

intmap_set = (m: IntMap, key: i64, value: i64) IntMap {
    grown = m.len == m.cap ?
        | true {
            nc = m.cap * 2
            IntMap {
                keys: raw_reallocate(m.keys, cast(slot(m.cap), usize), cast(slot(nc), usize)),
                vals: raw_reallocate(m.vals, cast(slot(m.cap), usize), cast(slot(nc), usize)),
                len: m.len,
                cap: nc,
            }
        }
        | false { m }
    store_i64(gep(grown.keys, slot(grown.len)), key)
    store_i64(gep(grown.vals, slot(grown.len)), value)
    IntMap { keys: grown.keys, vals: grown.vals, len: grown.len + 1, cap: grown.cap }
}

scan = (m: IntMap, key: i64, i: i64) i64 {
    i >= m.len ?
        | true { cast(0 - 1, i64) }
        | false {
            load_i64(gep(m.keys, slot(i))) == key ?
                | true { load_i64(gep(m.vals, slot(i))) }
                | false { scan(m, key, i + 1) }
        }
}

// Returns the value for `key`, or -1 if absent.
intmap_get = (m: IntMap, key: i64) i64 {
    scan(m, key, 0)
}

intmap_free = (m: IntMap) void {
    raw_deallocate(m.keys, cast(slot(m.cap), usize))
    raw_deallocate(m.vals, cast(slot(m.cap), usize))
}

@export({ IntMap, intmap_new, intmap_len, intmap_set, intmap_get, intmap_free })
