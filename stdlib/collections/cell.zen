// Minimal heap-allocated i64 cell — proves allocator-backed stdlib types.
Cell: { slot: RawPtr<u8> }

cell_new = (v: i64) Cell {
    p = @builtin.raw_allocate(@builtin.sizeof<i64>())
    @builtin.store(p, v)
    Cell { slot: p }
}
cell_get = (c: Cell) i64 {
    @builtin.load<i64>(c.slot)
}
cell_free = (c: Cell) void {
    @builtin.raw_deallocate(c.slot, @builtin.sizeof<i64>())
}

@export({ Cell, cell_new, cell_get, cell_free })
