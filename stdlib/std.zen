// Zen Standard Library Entry Point
// Re-exports all standard library modules
// Types use method-based API: Type.method(self, args)

// Core modules - Option and Result types
{ Option } = @std.core.option
{ Result } = @std.core.result
{ Ptr } = @std.core.ptr

// Range iterator type
{ Range, range, range_step } = @std.core.iterator

// Memory management - Allocators
{ Allocator } = @std.memory.allocator
{ GPA } = @std.memory.gpa

// String type (use String.new, String.len, etc.)
{ String } = @std.string

// Vector type (use Vec<T>.new, Vec<T>.push, etc.)
{ Vec } = @std.vec

// Collections (use Type<T>.new, Type<T>.method, etc.)
{ Queue } = @std.collections.queue
{ Stack } = @std.collections.stack
{ Set } = @std.collections.set
{ HashMap } = @std.collections.hashmap
{ LinkedList } = @std.collections.linkedlist

// Build system types and functions
{ Build, Target, Executable, StaticLibrary, Test, Dependency, OptimizeMode, OsTag, CpuArch, InstallDir, Version, ExeOptions, LibOptions, DepOptions } = @std.build.build
{ native_target, os_name, cpu_name, new_build, add_executable, add_test, add_static_library, add_dependency, install_artifact, install_library, install_file, get_install_path, link_system_library, link_framework, add_library_path, define_symbol, optimize_name } = @std.build.build

// IO functions (includes syscall-based I/O: sys_write, sys_ewrite, sys_write_raw)
{ STDIN, STDOUT, STDERR, print, println, eprint, eprintln, read_line, read_input, sys_write, sys_ewrite, sys_write_raw } = @std.io.io

// Socket I/O (syscall-based TCP/UDP for Linux x86-64)
{ Socket, TcpListener, TcpStream, UdpSocket, SocketAddrV4, Ipv4Addr, SocketError } = @std.io.socket
{ tcp_socket, tcp_bind, tcp_listen, tcp_accept, tcp_connect, tcp_send, tcp_recv } = @std.io.socket
{ udp_socket, udp_bind, udp_sendto, udp_recvfrom } = @std.io.socket
{ socket_close, socket_shutdown, socket_set_reuseaddr, tcp_set_nodelay, udp_set_broadcast } = @std.io.socket
{ htons, ntohs, htonl } = @std.io.socket

// Process management (syscall-based for Linux x86-64)
{ ProcessError, ExitStatus, Pipe } = @std.io.process
{ fork, exit, wait, waitpid, try_wait, kill, spawn, spawn_wait } = @std.io.process
{ getpid, getppid, getuid, getgid, geteuid, getegid } = @std.io.process
{ pipe, dup, dup2, setsid, getpgid, setpgid } = @std.io.process
{ SIGINT, SIGTERM, SIGKILL, SIGHUP, SIGCHLD } = @std.io.process

// Directory operations (syscall-based for Linux x86-64)
{ FileStat, DirEntry, Dir, DirError } = @std.io.dir
{ stat, lstat, fstat, path_exists, is_file, is_dir, is_symlink, file_size } = @std.io.dir
{ read_dir, readlink, symlink, link, chmod, fchmod } = @std.io.dir
{ S_IFREG, S_IFDIR, S_IFLNK, DT_REG, DT_DIR, DT_LNK } = @std.io.dir

// Epoll async I/O (syscall-based for Linux x86-64)
{ Epoll, EpollEvent, EpollEventIterator, EpollError } = @std.io.epoll
{ EventLoop, Interest, Token, Readiness } = @std.io.epoll
{ EPOLLIN, EPOLLOUT, EPOLLERR, EPOLLHUP, EPOLLET } = @std.io.epoll

