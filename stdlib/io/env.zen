// Zen Standard Library: Environment Variables (Syscall-based)
// Direct syscall implementation for Linux x86-64
// No FFI - reads from /proc/self/environ
// Note: Writing to environ requires libc, so we only support reading

{ compiler } = @std
{ Result } = @std.core.result
{ Option } = @std.core.option
{ String } = @std.string
{ Vec } = @std.vec
{ Allocator } = @std.memory.allocator

// ============================================================================
// Linux x86-64 Syscall Numbers
// ============================================================================

SYS_OPEN = 2
SYS_READ = 0
SYS_CLOSE = 3
SYS_GETCWD = 79
SYS_GETUID = 102
SYS_GETEUID = 107
SYS_GETPID = 39

// Open flags
O_RDONLY = 0

// ============================================================================
// Error Type
// ============================================================================

EnvError: {
    code: i32
}

env_errno_to_error = (errno: i64) EnvError {
    code = 0 - errno
    return EnvError { code: code }
}

// ============================================================================
// Low-Level Syscalls
// ============================================================================

sys_open = (pathname: i64, flags: i32, mode: i32) i64 {
    return compiler.syscall3(SYS_OPEN, pathname, flags, mode)
}

sys_read = (fd: i32, buf: i64, count: usize) i64 {
    return compiler.syscall3(SYS_READ, fd, buf, count)
}

sys_close = (fd: i32) i64 {
    return compiler.syscall1(SYS_CLOSE, fd)
}

sys_getcwd = (buf: i64, size: usize) i64 {
    return compiler.syscall2(SYS_GETCWD, buf, size)
}

sys_getuid = () i64 {
    return compiler.syscall0(SYS_GETUID)
}

sys_geteuid = () i64 {
    return compiler.syscall0(SYS_GETEUID)
}

sys_getpid = () i64 {
    return compiler.syscall0(SYS_GETPID)
}

// ============================================================================
// Environment Entry
// ============================================================================

EnvEntry: {
    key: String,
    value: String
}

// Free entry
EnvEntry.free = (self: MutPtr<EnvEntry>) void {
    self.val.key.mut_ref().free()
    self.val.value.mut_ref().free()
}

// ============================================================================
// Read Environment
// ============================================================================

// Path to environ file
PROC_ENVIRON = "/proc/self/environ"

// Read all environment variables from /proc/self/environ
// Format: KEY=VALUE\0KEY=VALUE\0...
read_environ = (allocator: Allocator) Result<Vec<EnvEntry>, EnvError> {
    // Open /proc/self/environ
    path_ptr = allocator.allocate(20)
    i = 0
    loop {
        i >= 19 ?
            | true { break }
            | false {
                ch = PROC_ENVIRON.at(i)
                compiler.store<u8>(compiler.gep(path_ptr, i), ch)
                i = i + 1
            }
    }
    compiler.store<u8>(compiler.gep(path_ptr, 19), 0)

    fd = sys_open(path_ptr, O_RDONLY, 0)
    allocator.deallocate(path_ptr, 20)

    fd < 0 ?
        | true { return Result.Err(env_errno_to_error(fd)) }
        | false { }

    // Read entire file (environ is typically small, use 64KB buffer)
    buf_size = 65536
    buf = allocator.allocate(buf_size)
    total_read = 0

    loop {
        remaining = buf_size - total_read
        remaining <= 0 ?
            | true { break }
            | false { }

        n = sys_read(fd, compiler.gep(buf, total_read), remaining)
        n <= 0 ?
            | true { break }
            | false { total_read = total_read + n }
    }

    _ = sys_close(fd)

    // Parse entries
    entries = Vec<EnvEntry>.new(allocator)
    pos = 0

    loop {
        pos >= total_read ?
            | true { break }
            | false { }

        // Find end of this entry (null terminator)
        entry_start = pos
        loop {
            pos >= total_read ?
                | true { break }
                | false {
                    ch = compiler.load<u8>(compiler.gep(buf, pos))
                    ch == 0 ?
                        | true { break }
                        | false { pos = pos + 1 }
                }
        }

        entry_len = pos - entry_start
        entry_len > 0 ?
            | true {
                // Find '=' separator
                eq_pos = entry_start
                found_eq = false
                loop {
                    eq_pos >= pos ?
                        | true { break }
                        | false {
                            ch = compiler.load<u8>(compiler.gep(buf, eq_pos))
                            ch == 61 ?  // '='
                                | true {
                                    found_eq = true
                                    break
                                }
                                | false { eq_pos = eq_pos + 1 }
                        }
                }

                found_eq ?
                    | true {
                        // Extract key
                        key_len = eq_pos - entry_start
                        key_buf = allocator.allocate(key_len + 1)
                        compiler.memcpy(key_buf, compiler.gep(buf, entry_start), key_len)
                        compiler.store<u8>(compiler.gep(key_buf, key_len), 0)
                        key = String.from_ptr(key_buf, key_len, allocator)

                        // Extract value
                        value_start = eq_pos + 1
                        value_len = pos - value_start
                        value_buf = allocator.allocate(value_len + 1)
                        compiler.memcpy(value_buf, compiler.gep(buf, value_start), value_len)
                        compiler.store<u8>(compiler.gep(value_buf, value_len), 0)
                        value = String.from_ptr(value_buf, value_len, allocator)

                        entry = EnvEntry { key: key, value: value }
                        entries.mut_ref().push(entry)
                    }
                    | false { }
            }
            | false { }

        // Skip null terminator
        pos = pos + 1
    }

    allocator.deallocate(buf, buf_size)
    return Result.Ok(entries)
}

// ============================================================================
// Get Single Environment Variable
// ============================================================================

// Get environment variable by name
// Returns None if not found
getenv = (name: String, allocator: Allocator) Result<Option<String>, EnvError> {
    environ_result = read_environ(allocator)

    environ_result ?
        | Err(e) { return Result.Err(e) }
        | Ok(entries) {
            found = Option.None
            i = 0
            len = entries.len()

            loop {
                i >= len ?
                    | true { break }
                    | false {
                        entry_opt = entries.get(i)
                        entry_opt ?
                            | Some(entry) {
                                entry.key.equals(name) ?
                                    | true {
                                        // Clone the value
                                        found = Option.Some(entry.value.clone(allocator))
                                        break
                                    }
                                    | false { }
                            }
                            | None { }
                        i = i + 1
                    }
            }

            // Free all entries
            j = 0
            loop {
                j >= len ?
                    | true { break }
                    | false {
                        entry_opt = entries.get(j)
                        entry_opt ?
                            | Some(entry) { entry.mut_ref().free() }
                            | None { }
                        j = j + 1
                    }
            }
            entries.mut_ref().free()

            return Result.Ok(found)
        }
}

// Check if environment variable exists
env_exists = (name: String, allocator: Allocator) bool {
    result = getenv(name, allocator)
    result ?
        | Err(_) { return false }
        | Ok(opt) {
            opt ?
                | Some(val) {
                    val.mut_ref().free()
                    return true
                }
                | None { return false }
        }
}

// Get environment variable with default
getenv_or = (name: String, default: String, allocator: Allocator) String {
    result = getenv(name, allocator)
    result ?
        | Err(_) { return default.clone(allocator) }
        | Ok(opt) {
            opt ?
                | Some(val) { return val }
                | None { return default.clone(allocator) }
        }
}

// ============================================================================
// Common Environment Variables
// ============================================================================

// Get HOME directory
home_dir = (allocator: Allocator) Result<Option<String>, EnvError> {
    home = String.from("HOME", allocator)
    result = getenv(home, allocator)
    home.mut_ref().free()
    return result
}

// Get PATH
path = (allocator: Allocator) Result<Option<String>, EnvError> {
    path_name = String.from("PATH", allocator)
    result = getenv(path_name, allocator)
    path_name.mut_ref().free()
    return result
}

// Get USER
user = (allocator: Allocator) Result<Option<String>, EnvError> {
    user_name = String.from("USER", allocator)
    result = getenv(user_name, allocator)
    user_name.mut_ref().free()
    return result
}

// Get SHELL
shell = (allocator: Allocator) Result<Option<String>, EnvError> {
    shell_name = String.from("SHELL", allocator)
    result = getenv(shell_name, allocator)
    shell_name.mut_ref().free()
    return result
}

// Get PWD (note: this may be stale, use getcwd for accurate value)
pwd = (allocator: Allocator) Result<Option<String>, EnvError> {
    pwd_name = String.from("PWD", allocator)
    result = getenv(pwd_name, allocator)
    pwd_name.mut_ref().free()
    return result
}

// Get TERM
term = (allocator: Allocator) Result<Option<String>, EnvError> {
    term_name = String.from("TERM", allocator)
    result = getenv(term_name, allocator)
    term_name.mut_ref().free()
    return result
}

// Get LANG
lang = (allocator: Allocator) Result<Option<String>, EnvError> {
    lang_name = String.from("LANG", allocator)
    result = getenv(lang_name, allocator)
    lang_name.mut_ref().free()
    return result
}

// ============================================================================
// Current Working Directory (syscall-based, not from environ)
// ============================================================================

// Get current working directory
getcwd = (allocator: Allocator) Result<String, EnvError> {
    buf_size = 4096
    buf = allocator.allocate(buf_size)

    result = sys_getcwd(buf, buf_size)

    result == 0 ?
        | true {
            allocator.deallocate(buf, buf_size)
            return Result.Err(EnvError { code: 2 })  // ENOENT
        }
        | false { }

    // Find null terminator
    len = 0
    loop {
        len >= buf_size ?
            | true { break }
            | false {
                ch = compiler.load<u8>(compiler.gep(buf, len))
                ch == 0 ?
                    | true { break }
                    | false { len = len + 1 }
            }
    }

    // Create string from buffer
    cwd = String.from_ptr(buf, len, allocator)
    return Result.Ok(cwd)
}

// ============================================================================
// User/Process Info
// ============================================================================

// Get user ID
getuid = () i32 {
    return sys_getuid()
}

// Get effective user ID
geteuid = () i32 {
    return sys_geteuid()
}

// Get process ID
getpid = () i32 {
    return sys_getpid()
}

// ============================================================================
// Path Operations
// ============================================================================

// Split PATH into individual directories
split_path = (path_value: String, allocator: Allocator) Vec<String> {
    dirs = Vec<String>.new(allocator)

    start = 0
    i = 0
    len = path_value.len()

    loop {
        i >= len ?
            | true {
                // Add final segment
                seg_len = i - start
                seg_len > 0 ?
                    | true {
                        seg_buf = allocator.allocate(seg_len + 1)
                        j = 0
                        loop {
                            j >= seg_len ?
                                | true { break }
                                | false {
                                    compiler.store<u8>(compiler.gep(seg_buf, j), path_value.at(start + j))
                                    j = j + 1
                                }
                        }
                        compiler.store<u8>(compiler.gep(seg_buf, seg_len), 0)
                        seg = String.from_ptr(seg_buf, seg_len, allocator)
                        dirs.mut_ref().push(seg)
                    }
                    | false { }
                break
            }
            | false {
                ch = path_value.at(i)
                ch == 58 ?  // ':'
                    | true {
                        // Add segment
                        seg_len = i - start
                        seg_len > 0 ?
                            | true {
                                seg_buf = allocator.allocate(seg_len + 1)
                                j = 0
                                loop {
                                    j >= seg_len ?
                                        | true { break }
                                        | false {
                                            compiler.store<u8>(compiler.gep(seg_buf, j), path_value.at(start + j))
                                            j = j + 1
                                        }
                                }
                                compiler.store<u8>(compiler.gep(seg_buf, seg_len), 0)
                                seg = String.from_ptr(seg_buf, seg_len, allocator)
                                dirs.mut_ref().push(seg)
                            }
                            | false { }
                        start = i + 1
                    }
                    | false { }
                i = i + 1
            }
    }

    return dirs
}

// ============================================================================
// Arguments (from /proc/self/cmdline)
// ============================================================================

// Read command line arguments
// Format: arg0\0arg1\0arg2\0...
read_args = (allocator: Allocator) Result<Vec<String>, EnvError> {
    // Open /proc/self/cmdline
    path = "/proc/self/cmdline"
    path_ptr = allocator.allocate(21)
    i = 0
    loop {
        i >= 20 ?
            | true { break }
            | false {
                ch = path.at(i)
                compiler.store<u8>(compiler.gep(path_ptr, i), ch)
                i = i + 1
            }
    }
    compiler.store<u8>(compiler.gep(path_ptr, 20), 0)

    fd = sys_open(path_ptr, O_RDONLY, 0)
    allocator.deallocate(path_ptr, 21)

    fd < 0 ?
        | true { return Result.Err(env_errno_to_error(fd)) }
        | false { }

    // Read file
    buf_size = 4096
    buf = allocator.allocate(buf_size)
    total_read = sys_read(fd, buf, buf_size)
    _ = sys_close(fd)

    total_read < 0 ?
        | true {
            allocator.deallocate(buf, buf_size)
            return Result.Err(env_errno_to_error(total_read))
        }
        | false { }

    // Parse arguments
    args = Vec<String>.new(allocator)
    pos = 0

    loop {
        pos >= total_read ?
            | true { break }
            | false { }

        // Find end of this argument
        start = pos
        loop {
            pos >= total_read ?
                | true { break }
                | false {
                    ch = compiler.load<u8>(compiler.gep(buf, pos))
                    ch == 0 ?
                        | true { break }
                        | false { pos = pos + 1 }
                }
        }

        arg_len = pos - start
        arg_len > 0 ?
            | true {
                arg_buf = allocator.allocate(arg_len + 1)
                compiler.memcpy(arg_buf, compiler.gep(buf, start), arg_len)
                compiler.store<u8>(compiler.gep(arg_buf, arg_len), 0)
                arg = String.from_ptr(arg_buf, arg_len, allocator)
                args.mut_ref().push(arg)
            }
            | false { }

        pos = pos + 1
    }

    allocator.deallocate(buf, buf_size)
    return Result.Ok(args)
}

