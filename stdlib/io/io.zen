// Zen stdlib: IO on @builtin intrinsics. fd 1=stdout, 2=stderr.
print = (message: StaticString) void {
    @builtin.libc_write(1, @builtin.static_string_ptr(message), @builtin.strlen(message))
}
println = (message: StaticString) void {
    @builtin.libc_write(1, @builtin.static_string_ptr(message), @builtin.strlen(message))
    @builtin.libc_write(1, @builtin.static_string_ptr("\n"), 1)
}
eprintln = (message: StaticString) void {
    @builtin.libc_write(2, @builtin.static_string_ptr(message), @builtin.strlen(message))
    @builtin.libc_write(2, @builtin.static_string_ptr("\n"), 1)
}
