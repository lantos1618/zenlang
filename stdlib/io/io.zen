// Zen Standard Library: IO Module
// Input/Output operations using compiler intrinsics

{ compiler } = @std
{ SYS_WRITE } = @std.sys.syscall

// =============================================================================
// PRINT FUNCTIONS (stdout)
// =============================================================================

// Print a StaticString to stdout (no newline)
print = (message: StaticString) void {
    compiler.libc_write(1, compiler.static_string_ptr(message), compiler.strlen(message))
}

// Print a StaticString to stdout with newline
println = (message: StaticString) void {
    compiler.libc_write(1, compiler.static_string_ptr(message), compiler.strlen(message))
    newline = compiler.ptr_to_int(compiler.static_string_ptr("\n"))
    compiler.syscall3(SYS_WRITE, 1, newline, 1)
}

// =============================================================================
// ERROR PRINT FUNCTIONS (stderr)
// =============================================================================

// Print a StaticString to stderr (no newline)
eprint = (message: StaticString) void {
    compiler.libc_write(2, compiler.static_string_ptr(message), compiler.strlen(message))
}

// Print a StaticString to stderr with newline
eprintln = (message: StaticString) void {
    compiler.libc_write(2, compiler.static_string_ptr(message), compiler.strlen(message))
    newline = compiler.ptr_to_int(compiler.static_string_ptr("\n"))
    compiler.syscall3(SYS_WRITE, 2, newline, 1)
}

// =============================================================================
// LOW-LEVEL IO (syscall-based, no libc dependency)
// =============================================================================

// Write using raw syscall (Linux x86-64 only, no libc)
// Use this when you need to avoid libc entirely
sys_write = (msg: StaticString, len: i64) i64 {
    msg_ptr = compiler.ptr_to_int(compiler.static_string_ptr(msg))
    compiler.syscall3(SYS_WRITE, 1, msg_ptr, len)
}

// Write to stderr using raw syscall
sys_ewrite = (msg: StaticString, len: i64) i64 {
    msg_ptr = compiler.ptr_to_int(compiler.static_string_ptr(msg))
    compiler.syscall3(SYS_WRITE, 2, msg_ptr, len)
}

// Raw syscall write to any file descriptor
sys_write_raw = (fd: i64, buf: RawPtr<u8>, count: i64) i64 {
    buf_addr = compiler.ptr_to_int(buf)
    compiler.syscall3(SYS_WRITE, fd, buf_addr, count)
}
