// Zen Standard Library: io_uring (Syscall-based)
{ compiler } = @std
{ Result } = @std.core.result
{ Option } = @std.core.option
{ SYS_IO_URING_SETUP, SYS_IO_URING_ENTER, SYS_MMAP, SYS_MUNMAP, SYS_CLOSE } = @std.sys.syscall
{ IORING_ENTER_GETEVENTS, IORING_OP_ACCEPT, IORING_OP_CLOSE, IORING_OP_READ, IORING_OP_WRITE,
  IORING_OFF_CQ_RING, IORING_OFF_SQ_RING, IORING_OFF_SQES, MAP_POPULATE, MAP_SHARED,
  PROT_READ, PROT_WRITE } = @std.io.mux.uring_constants

SQE: {
    opcode: u8,
    flags: u8,
    ioprio: u16,
    fd: i32,
    off: u64,      // offset or addr2
    addr: u64,     // address or splice_off_in
    len: u32,      // length or splice_flags
    op_flags: u32, // operation-specific flags
    user_data: u64,
    buf_index: u16,
    personality: u16,
    splice_fd_in: i32,
    pad2: u64,
    pad3: u64
}

CQE: {
    user_data: u64,  // Copied from SQE
    res: i32,        // Result (bytes transferred or error)
    flags: u32       // Completion flags
}

IoUringParams: {
    sq_entries: u32,
    cq_entries: u32,
    flags: u32,
    sq_thread_cpu: u32,
    sq_thread_idle: u32,
    features: u32,
    wq_fd: u32,
    resv: u64,       // Reserved (3 u32s)
    resv2: u64,
    sq_off_head: u32,
    sq_off_tail: u32,
    sq_off_ring_mask: u32,
    sq_off_ring_entries: u32,
    sq_off_flags: u32,
    sq_off_dropped: u32,
    sq_off_array: u32,
    sq_off_resv1: u32,
    sq_off_resv2: u64,
    cq_off_head: u32,
    cq_off_tail: u32,
    cq_off_ring_mask: u32,
    cq_off_ring_entries: u32,
    cq_off_overflow: u32,
    cq_off_cqes: u32,
    cq_off_flags: u32,
    cq_off_resv1: u32,
    cq_off_resv2: u64
}

IoUring: {
    ring_fd: i32,
    sq_entries: u32,
    cq_entries: u32,
    sq_ring_ptr: i64,
    sq_ring_size: usize,
    sqes_ptr: i64,
    sqes_size: usize,
    sq_head: i64,      // Pointer to head
    sq_tail: i64,      // Pointer to tail
    sq_mask: u32,
    sq_array: i64,     // Pointer to array
    cq_ring_ptr: i64,
    cq_ring_size: usize,
    cq_head: i64,
    cq_tail: i64,
    cq_mask: u32,
    cqes: i64          // Pointer to CQEs
}

IoUring.new = (entries: u32) Result<IoUring, i32> {
    params_ptr = compiler.raw_allocate(120)
    compiler.memset(params_ptr, 0, 120)
    fd = compiler.syscall2(SYS_IO_URING_SETUP, entries, compiler.ptr_to_int(params_ptr))
    fd < 0 ?
        | true {
            compiler.raw_deallocate(params_ptr, 120)
            Result.Err(cast(0 - fd, i32))
        }
        | false { IoUring.map_rings(cast(fd, i32), params_ptr) }
}

IoUring.map_rings = (fd: i32, params_ptr: i64) Result<IoUring, i32> {
    sq_entries = compiler.load<u32>(params_ptr)
    cq_entries = compiler.load<u32>(compiler.gep(params_ptr, 4))
    sq_off_head = compiler.load<u32>(compiler.gep(params_ptr, 32))
    sq_off_tail = compiler.load<u32>(compiler.gep(params_ptr, 36))
    sq_off_ring_mask = compiler.load<u32>(compiler.gep(params_ptr, 40))
    sq_off_array = compiler.load<u32>(compiler.gep(params_ptr, 52))
    cq_off_head = compiler.load<u32>(compiler.gep(params_ptr, 72))
    cq_off_tail = compiler.load<u32>(compiler.gep(params_ptr, 76))
    cq_off_ring_mask = compiler.load<u32>(compiler.gep(params_ptr, 80))
    cq_off_cqes = compiler.load<u32>(compiler.gep(params_ptr, 88))
    sq_ring_size = cast(sq_off_array, usize) + cast(sq_entries, usize) * 4
    cq_ring_size = cast(cq_off_cqes, usize) + cast(cq_entries, usize) * 16
    sqes_size = cast(sq_entries, usize) * 64
    sq_ring_ptr = compiler.syscall6(
        SYS_MMAP, 0, sq_ring_size,
        PROT_READ | PROT_WRITE, MAP_SHARED | MAP_POPULATE,
        fd, IORING_OFF_SQ_RING
    )
    sq_ring_ptr < 0 ?
        | true {
            compiler.syscall1(SYS_CLOSE, fd)
            compiler.raw_deallocate(params_ptr, 120)
            Result.Err(cast(0 - sq_ring_ptr, i32))
        }
        | false {
            IoUring.map_sqes(
                fd,
                params_ptr,
                sq_entries,
                cq_entries,
                sq_off_head,
                sq_off_tail,
                sq_off_ring_mask,
                sq_off_array,
                cq_off_head,
                cq_off_tail,
                cq_off_ring_mask,
                cq_off_cqes,
                sq_ring_size,
                cq_ring_size,
                sqes_size,
                sq_ring_ptr
            )
        }
}

IoUring.map_sqes = (
    fd: i32,
    params_ptr: i64,
    sq_entries: u32,
    cq_entries: u32,
    sq_off_head: u32,
    sq_off_tail: u32,
    sq_off_ring_mask: u32,
    sq_off_array: u32,
    cq_off_head: u32,
    cq_off_tail: u32,
    cq_off_ring_mask: u32,
    cq_off_cqes: u32,
    sq_ring_size: usize,
    cq_ring_size: usize,
    sqes_size: usize,
    sq_ring_ptr: i64
) Result<IoUring, i32> {
    sqes_ptr = compiler.syscall6(
        SYS_MMAP, 0, sqes_size,
        PROT_READ | PROT_WRITE, MAP_SHARED | MAP_POPULATE,
        fd, IORING_OFF_SQES
    )
    sqes_ptr < 0 ?
        | true {
            compiler.syscall2(SYS_MUNMAP, sq_ring_ptr, sq_ring_size)
            compiler.syscall1(SYS_CLOSE, fd)
            compiler.raw_deallocate(params_ptr, 120)
            Result.Err(cast(0 - sqes_ptr, i32))
        }
        | false {
            IoUring.map_cq_ring(
                fd,
                params_ptr,
                sq_entries,
                cq_entries,
                sq_off_head,
                sq_off_tail,
                sq_off_ring_mask,
                sq_off_array,
                cq_off_head,
                cq_off_tail,
                cq_off_ring_mask,
                cq_off_cqes,
                sq_ring_size,
                cq_ring_size,
                sqes_size,
                sq_ring_ptr,
                sqes_ptr
            )
        }
}

IoUring.map_cq_ring = (
    fd: i32,
    params_ptr: i64,
    sq_entries: u32,
    cq_entries: u32,
    sq_off_head: u32,
    sq_off_tail: u32,
    sq_off_ring_mask: u32,
    sq_off_array: u32,
    cq_off_head: u32,
    cq_off_tail: u32,
    cq_off_ring_mask: u32,
    cq_off_cqes: u32,
    sq_ring_size: usize,
    cq_ring_size: usize,
    sqes_size: usize,
    sq_ring_ptr: i64,
    sqes_ptr: i64
) Result<IoUring, i32> {
    cq_ring_ptr = compiler.syscall6(
        SYS_MMAP, 0, cq_ring_size,
        PROT_READ | PROT_WRITE, MAP_SHARED | MAP_POPULATE,
        fd, IORING_OFF_CQ_RING
    )
    cq_ring_ptr < 0 ?
        | true {
            compiler.syscall2(SYS_MUNMAP, sqes_ptr, sqes_size)
            compiler.syscall2(SYS_MUNMAP, sq_ring_ptr, sq_ring_size)
            compiler.syscall1(SYS_CLOSE, fd)
            compiler.raw_deallocate(params_ptr, 120)
            Result.Err(cast(0 - cq_ring_ptr, i32))
        }
        | false {
            IoUring.finish_new(
                fd,
                params_ptr,
                sq_entries,
                cq_entries,
                sq_off_head,
                sq_off_tail,
                sq_off_ring_mask,
                sq_off_array,
                cq_off_head,
                cq_off_tail,
                cq_off_ring_mask,
                cq_off_cqes,
                sq_ring_size,
                cq_ring_size,
                sqes_size,
                sq_ring_ptr,
                sqes_ptr,
                cq_ring_ptr
            )
        }
}

IoUring.finish_new = (
    fd: i32,
    params_ptr: i64,
    sq_entries: u32,
    cq_entries: u32,
    sq_off_head: u32,
    sq_off_tail: u32,
    sq_off_ring_mask: u32,
    sq_off_array: u32,
    cq_off_head: u32,
    cq_off_tail: u32,
    cq_off_ring_mask: u32,
    cq_off_cqes: u32,
    sq_ring_size: usize,
    cq_ring_size: usize,
    sqes_size: usize,
    sq_ring_ptr: i64,
    sqes_ptr: i64,
    cq_ring_ptr: i64
) Result<IoUring, i32> {
    sq_mask = compiler.load<u32>(compiler.int_to_ptr(sq_ring_ptr + cast(sq_off_ring_mask, i64)))
    cq_mask = compiler.load<u32>(compiler.int_to_ptr(cq_ring_ptr + cast(cq_off_ring_mask, i64)))
    ring = IoUring {
        ring_fd: fd,
        sq_entries: sq_entries,
        cq_entries: cq_entries,
        sq_ring_ptr: sq_ring_ptr,
        sq_ring_size: sq_ring_size,
        sqes_ptr: sqes_ptr,
        sqes_size: sqes_size,
        sq_head: sq_ring_ptr + cast(sq_off_head, i64),
        sq_tail: sq_ring_ptr + cast(sq_off_tail, i64),
        sq_mask: sq_mask,
        sq_array: sq_ring_ptr + cast(sq_off_array, i64),
        cq_ring_ptr: cq_ring_ptr,
        cq_ring_size: cq_ring_size,
        cq_head: cq_ring_ptr + cast(cq_off_head, i64),
        cq_tail: cq_ring_ptr + cast(cq_off_tail, i64),
        cq_mask: cq_mask,
        cqes: cq_ring_ptr + cast(cq_off_cqes, i64)
    }
    compiler.raw_deallocate(params_ptr, 120)
    Result.Ok(ring)
}

IoUring.get_sqe = (self: MutPtr<IoUring>) i64 {
    head = cast(compiler.atomic_load(compiler.raw_ptr_cast(compiler.int_to_ptr(self.val.sq_head))), u32)
    tail = compiler.load<u32>(compiler.int_to_ptr(self.val.sq_tail))
    (tail - head) >= self.val.sq_entries ?
        | true { 0 }
        | false {
            idx = tail & self.val.sq_mask
            sqe_ptr = self.val.sqes_ptr + (cast(idx, i64) * 64)
            compiler.memset(compiler.int_to_ptr(sqe_ptr), 0, 64)
            sqe_ptr
        }
}

IoUring.submit_sqe = (self: MutPtr<IoUring>, sqe_ptr: i64) void {
    tail = compiler.load<u32>(compiler.int_to_ptr(self.val.sq_tail))
    idx = tail & self.val.sq_mask
    compiler.store<u32>(
        compiler.int_to_ptr(self.val.sq_array + cast(idx, i64) * 4),
        idx
    )
    compiler.atomic_store(
        compiler.raw_ptr_cast(compiler.int_to_ptr(self.val.sq_tail)),
        cast(tail + 1, u64)
    )
}

IoUring.submit = (self: MutPtr<IoUring>) Result<i32, i32> {
    result = compiler.syscall3(SYS_IO_URING_ENTER, self.val.ring_fd, 0, 0)
    result < 0 ?
        | true { Result.Err(cast(0 - result, i32)) }
        | false { Result.Ok(cast(result, i32)) }
}

IoUring.submit_and_wait = (self: MutPtr<IoUring>, min_complete: u32) Result<i32, i32> {
    result = compiler.syscall4(
        SYS_IO_URING_ENTER,
        self.val.ring_fd,
        0,
        min_complete,
        IORING_ENTER_GETEVENTS
    )
    result < 0 ?
        | true { Result.Err(cast(0 - result, i32)) }
        | false { Result.Ok(cast(result, i32)) }
}

IoUring.peek_cqe = (self: MutPtr<IoUring>) Option<CQE> {
    head = cast(compiler.atomic_load(compiler.raw_ptr_cast(compiler.int_to_ptr(self.val.cq_head))), u32)
    tail = cast(compiler.atomic_load(compiler.raw_ptr_cast(compiler.int_to_ptr(self.val.cq_tail))), u32)
    head == tail ?
        | true { Option.None }
        | false {
            idx = head & self.val.cq_mask
            cqe_ptr = self.val.cqes + (cast(idx, i64) * 16)
            cqe = CQE {
                user_data: compiler.load<u64>(compiler.int_to_ptr(cqe_ptr)),
                res: compiler.load<i32>(compiler.int_to_ptr(cqe_ptr + 8)),
                flags: compiler.load<u32>(compiler.int_to_ptr(cqe_ptr + 12))
            }
            Option.Some(cqe)
        }
}

IoUring.cqe_seen = (self: MutPtr<IoUring>) void {
    head = cast(compiler.atomic_load(compiler.raw_ptr_cast(compiler.int_to_ptr(self.val.cq_head))), u32)
    compiler.atomic_store(
        compiler.raw_ptr_cast(compiler.int_to_ptr(self.val.cq_head)),
        cast(head + 1, u64)
    )
}

IoUring.wait_cqe = (self: MutPtr<IoUring>) Result<CQE, i32> {
    cqe_check = self.peek_cqe()
    cqe_check ? {
        | Some(c) { Result.Ok(c) }
        | None {
            result = compiler.syscall4(
                SYS_IO_URING_ENTER,
                self.val.ring_fd,
                0,
                1,
                IORING_ENTER_GETEVENTS
            )
            result < 0 ?
                | true { Result.Err(cast(0 - result, i32)) }
                | false {
                    cqe = self.peek_cqe()
                    cqe ? {
                        | Some(c) { Result.Ok(c) }
                        | None { Result.Err(11) }  // EAGAIN
                    }
                }
        }
    }
}

IoUring.prep_read = (self: MutPtr<IoUring>, fd: i32, buf: i64, len: u32, offset: u64, user_data: u64) Result<(), i32> {
    sqe_ptr = self.get_sqe()
    sqe_ptr == 0 ?
        | true { Result.Err(11) }  // EAGAIN
        | false {
            compiler.store<u8>(compiler.int_to_ptr(sqe_ptr), IORING_OP_READ)      // opcode
            compiler.store<i32>(compiler.int_to_ptr(sqe_ptr + 4), fd)             // fd
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 8), offset)         // off
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 16), cast(buf, u64))    // addr
            compiler.store<u32>(compiler.int_to_ptr(sqe_ptr + 24), len)           // len
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 32), user_data)     // user_data
            self.submit_sqe(sqe_ptr)
            Result.Ok(())
        }
}

IoUring.prep_write = (self: MutPtr<IoUring>, fd: i32, buf: i64, len: u32, offset: u64, user_data: u64) Result<(), i32> {
    sqe_ptr = self.get_sqe()
    sqe_ptr == 0 ?
        | true { Result.Err(11) }
        | false {
            compiler.store<u8>(compiler.int_to_ptr(sqe_ptr), IORING_OP_WRITE)
            compiler.store<i32>(compiler.int_to_ptr(sqe_ptr + 4), fd)
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 8), offset)
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 16), cast(buf, u64))
            compiler.store<u32>(compiler.int_to_ptr(sqe_ptr + 24), len)
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 32), user_data)
            self.submit_sqe(sqe_ptr)
            Result.Ok(())
        }
}

IoUring.prep_accept = (self: MutPtr<IoUring>, fd: i32, addr: i64, addrlen: i64, user_data: u64) Result<(), i32> {
    sqe_ptr = self.get_sqe()
    sqe_ptr == 0 ?
        | true { Result.Err(11) }
        | false {
            compiler.store<u8>(compiler.int_to_ptr(sqe_ptr), IORING_OP_ACCEPT)
            compiler.store<i32>(compiler.int_to_ptr(sqe_ptr + 4), fd)
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 16), cast(addr, u64))
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 8), cast(addrlen, u64))  // off field used for addrlen ptr
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 32), user_data)
            self.submit_sqe(sqe_ptr)
            Result.Ok(())
        }
}

IoUring.prep_close = (self: MutPtr<IoUring>, fd: i32, user_data: u64) Result<(), i32> {
    sqe_ptr = self.get_sqe()
    sqe_ptr == 0 ?
        | true { Result.Err(11) }
        | false {
            compiler.store<u8>(compiler.int_to_ptr(sqe_ptr), IORING_OP_CLOSE)
            compiler.store<i32>(compiler.int_to_ptr(sqe_ptr + 4), fd)
            compiler.store<u64>(compiler.int_to_ptr(sqe_ptr + 32), user_data)
            self.submit_sqe(sqe_ptr)
            Result.Ok(())
        }
}

IoUring.close = (self: MutPtr<IoUring>) void {
    compiler.syscall2(SYS_MUNMAP, self.val.cq_ring_ptr, self.val.cq_ring_size)
    compiler.syscall2(SYS_MUNMAP, self.val.sqes_ptr, self.val.sqes_size)
    compiler.syscall2(SYS_MUNMAP, self.val.sq_ring_ptr, self.val.sq_ring_size)
    compiler.syscall1(SYS_CLOSE, self.val.ring_fd)
}
