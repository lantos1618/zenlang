// Zen Standard Library: Terminal Module
// Provides terminal control, size detection, and raw mode support

{ compiler } = @std
{ ByteBuffer } = @std.core.buffer
{ Allocator } = @std.memory.allocator

// ============================================================================
// Terminal Size
// ============================================================================

TermSize: {
    rows: i32,
    cols: i32
}

// Get terminal size using TIOCGWINSZ ioctl
// Returns default 80x24 if ioctl fails
Terminal.size = (buf: ByteBuffer) TermSize {
    addr = buf.addr()
    // TIOCGWINSZ = 0x5413
    result = compiler.syscall3(16, 1, 0x5413, addr)
    result < 0 ? {
        return TermSize { rows: 24, cols: 80 }
    }
    // winsize struct: { unsigned short ws_row, ws_col, ws_xpixel, ws_ypixel }
    rows = cast(buf.get(0), i32) + cast(buf.get(1), i32) * 256
    cols = cast(buf.get(2), i32) + cast(buf.get(3), i32) * 256
    return TermSize { rows: rows, cols: cols }
}

// ============================================================================
// Terminal State (for raw mode)
// ============================================================================

TermState: {
    old_termios: ByteBuffer,
    new_termios: ByteBuffer
}

// Enter raw mode - disable line buffering and echo
Terminal.raw_mode = (alloc: Allocator) TermState {
    old_buf = ByteBuffer.zeroed(alloc, 64)
    new_buf = ByteBuffer.zeroed(alloc, 64)

    old_addr = old_buf.addr()
    new_addr = new_buf.addr()

    // TCGETS = 0x5401
    compiler.syscall3(16, 0, 0x5401, old_addr)
    new_buf.copy(old_buf.ptr(), 60)

    // Clear ICANON and ECHO from c_lflag (offset 12)
    lflag = new_buf.get_u32(12)
    new_buf.set_u32(12, lflag / 16 * 16)  // Clear low 4 bits (ICANON=2, ECHO=8)

    // Set VMIN=1, VTIME=0 for blocking single-char read
    new_buf.set(23, 1)  // VMIN
    new_buf.set(22, 0)  // VTIME

    // TCSETS = 0x5402
    compiler.syscall3(16, 0, 0x5402, new_addr)

    return TermState { old_termios: old_buf, new_termios: new_buf }
}

// Restore original terminal settings
Terminal.restore = (ts: TermState) void {
    addr = ts.old_termios.addr()
    compiler.syscall3(16, 0, 0x5402, addr)
}

// Free terminal state buffers
Terminal.free_state = (ts: TermState, alloc: Allocator) void {
    ts.old_termios.free(alloc)
    ts.new_termios.free(alloc)
}

// ============================================================================
// Cursor and Screen Control
// ============================================================================

// Hide cursor
Terminal.hide_cursor = (buf: ByteBuffer) void {
    buf.write_str(0, "\x1b[?25l", 6)
    addr = buf.addr()
    compiler.syscall3(1, 1, addr, 6)
}

// Show cursor
Terminal.show_cursor = (buf: ByteBuffer) void {
    buf.write_str(0, "\x1b[?25h", 6)
    addr = buf.addr()
    compiler.syscall3(1, 1, addr, 6)
}

// Enter alternate screen buffer
Terminal.alt_screen_on = (buf: ByteBuffer) void {
    buf.write_str(0, "\x1b[?1049h", 8)
    addr = buf.addr()
    compiler.syscall3(1, 1, addr, 8)
}

// Leave alternate screen buffer
Terminal.alt_screen_off = (buf: ByteBuffer) void {
    buf.write_str(0, "\x1b[?1049l", 8)
    addr = buf.addr()
    compiler.syscall3(1, 1, addr, 8)
}

// Clear screen and move cursor to home
Terminal.clear = (buf: ByteBuffer) void {
    buf.write_str(0, "\x1b[H\x1b[J", 7)
    addr = buf.addr()
    compiler.syscall3(1, 1, addr, 7)
}

// Move cursor to position (1-indexed)
Terminal.move_to = (buf: ByteBuffer, row: i32, col: i32) void {
    // Simple version: \x1b[{row};{col}H
    // For now just write escape sequence with fixed format
    buf.write_str(0, "\x1b[", 2)
    // TODO: proper number formatting when we have int_to_string
}

// ============================================================================
// Input
// ============================================================================

// Read single key (blocking)
Terminal.read_key = (buf: ByteBuffer) i32 {
    addr = buf.addr()
    compiler.syscall3(0, 0, addr, 1)
    return cast(buf.get(0), i32)
}

// Poll for key (non-blocking) - returns 0 if no key
Terminal.poll_key = (buf: ByteBuffer) i32 {
    // Get current flags
    flags = compiler.syscall3(72, 0, 3, 0)
    // Add O_NONBLOCK (2048)
    compiler.syscall3(72, 0, 4, flags + 2048)

    addr = buf.addr()
    n = compiler.syscall3(0, 0, addr, 1)

    // Restore flags
    compiler.syscall3(72, 0, 4, flags)

    n > 0 ? { return cast(buf.get(0), i32) }
    return 0
}

// ============================================================================
// Timing
// ============================================================================

// Sleep for milliseconds
Terminal.sleep_ms = (buf: ByteBuffer, ms: i32) void {
    addr = buf.addr()
    buf.set_i64(0, 0)
    ms_ns = cast(ms, i64) * 1000000
    buf.set_i64(8, ms_ns)
    compiler.syscall2(35, addr, 0)
}
