// Optional value: `Some(T)` or `None`. The idiomatic result of a lookup that
// may miss (e.g. `hashmap_get`).
// `{ Option, option_unwrap_or, option_is_some } = std.core.option`

Option<T>:
    None,
    Some(T)

option_unwrap_or<T> = (value: Option<T>, fallback: T) T {
    value ?
        | Some(inner) { inner }
        | None { fallback }
}

option_is_some<T> = (value: Option<T>) bool {
    value ?
        | Some(_) { true }
        | None { false }
}

@export({ Option, option_unwrap_or, option_is_some })
