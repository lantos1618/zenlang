// Zen Standard Library: Character utilities (ASCII).
//
// Pure u8 classification and conversion logic — no intrinsics needed beyond the
// language itself. Imported as `{ char } = std`; call as `char.is_digit(c)`.

// ── Classification ──────────────────────────────────────────────

is_digit = (c: u8) bool {
    c >= 48 && c <= 57
}

is_alpha = (c: u8) bool {
    (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

is_alphanumeric = (c: u8) bool {
    is_digit(c) || is_alpha(c)
}

is_whitespace = (c: u8) bool {
    c == 32 || c == 9 || c == 10 || c == 13
}

is_uppercase = (c: u8) bool {
    c >= 65 && c <= 90
}

is_lowercase = (c: u8) bool {
    c >= 97 && c <= 122
}

is_hex_digit = (c: u8) bool {
    is_digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

is_control = (c: u8) bool {
    c < 32 || c == 127
}

is_printable = (c: u8) bool {
    c >= 32 && c <= 126
}

// ── Conversion ──────────────────────────────────────────────────

to_uppercase = (c: u8) u8 {
    is_lowercase(c) ?
        | true { c - 32 }
        | false { c }
}

to_lowercase = (c: u8) u8 {
    is_uppercase(c) ?
        | true { c + 32 }
        | false { c }
}

digit_to_int = (c: u8) i32 {
    is_digit(c) ?
        | true { cast(c - 48, i32) }
        | false { -1 }
}

@export({ is_digit, is_alpha, is_alphanumeric, is_whitespace, is_uppercase, is_lowercase, is_hex_digit, is_control, is_printable, to_uppercase, to_lowercase, digit_to_int })
