// main.zen - Entry point for a multi-file Zen project
//
// Local files import by module name. The std import uses the current compiler
// runtime stand-in while package semantics remain gated.

{ io } = std
{ clamp, factorial, is_even } = math_utils

main = () i32 {
    io.println("factorial(6) = ${factorial(6)}")
    io.println("clamp(15, 0, 10) = ${clamp(15, 0, 10)}")

    is_even(42) ?
        | true { io.println("42 is even") }
        | false { io.println("42 is odd") }

    0
}
