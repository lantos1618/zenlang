// Structs and Methods in Zen
// Zen uses UFC (Uniform Function Call) - any function is also a method

{ io } = std

// Struct with fields
Point: {
    x: f64,
    y: f64,
}

// Functions that work as methods via UFC
distance_squared = (p: Point) f64 {
    return p.x * p.x + p.y * p.y
}

add_points = (a: Point, b: Point) Point {
    return Point { x: a.x + b.x, y: a.y + b.y }
}

scale = (p: Point, factor: f64) Point {
    return Point { x: p.x * factor, y: p.y * factor }
}

to_string = (p: Point) StringLiteral {
    return "(${p.x}, ${p.y})"
}

// A more complex struct
Rectangle: {
    origin: Point,
    width: f64,
    height: f64,
}

area = (r: Rectangle) f64 {
    return r.width * r.height
}

perimeter = (r: Rectangle) f64 {
    return 2.0 * (r.width + r.height)
}

contains = (r: Rectangle, p: Point) bool {
    x_in = p.x >= r.origin.x && p.x <= r.origin.x + r.width
    y_in = p.y >= r.origin.y && p.y <= r.origin.y + r.height
    return x_in && y_in
}

main = () i32 {
    // Create points
    p1 = Point { x: 3.0, y: 4.0 }
    p2 = Point { x: 1.0, y: 2.0 }

    // UFC: function call as method
    io.println("p1 = ${p1.to_string()}")
    io.println("p2 = ${p2.to_string()}")
    io.println("Distance squared from origin: ${p1.distance_squared()}")

    // UFC with multiple params
    p3 = p1.add_points(p2)
    io.println("p1 + p2 = ${p3.to_string()}")

    scaled = p1.scale(2.5)
    io.println("p1 * 2.5 = ${scaled.to_string()}")

    // Rectangle
    rect = Rectangle {
        origin: Point { x: 0.0, y: 0.0 },
        width: 10.0,
        height: 5.0,
    }

    io.println("Area: ${rect.area()}")
    io.println("Perimeter: ${rect.perimeter()}")

    // Point containment
    inside = Point { x: 5.0, y: 3.0 }
    outside = Point { x: 15.0, y: 3.0 }

    rect.contains(inside) ?
        | true { io.println("(5,3) is inside") }
        | false { io.println("(5,3) is outside") }

    rect.contains(outside) ?
        | true { io.println("(15,3) is inside") }
        | false { io.println("(15,3) is outside") }

    return 0
}
