// main.zen - Using the new build.zen package system
//
// Notice: no @std prefix needed! `std` comes from build.zen.

{ io } = std.io
{ Result } = std.core.result

// Simple greeting
greet = (name: StaticString) void {
    io.println("Hello, ${name}!")
}

// Demonstrate that both old and new import styles work
main = () i32 {
    io.println("=== Zen Build System Demo ===")
    io.println("")

    greet("World")
    greet("Zen")

    io.println("")
    io.println("This file uses { io } = std.io")
    io.println("The 'std' package is declared in build.zen")

    return 0
}
