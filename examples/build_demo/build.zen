// build.zen - Project configuration
//
// This file declares what packages are available to your project.
// Individual source files reference packages by name — no @std needed.
//
// Reserved: @ prefix is for @builtin raw intrinsics (only used in compiler.zen)

std = @builtin.import_std()

// Build configuration
build = (b: std.build.Builder) void {
    b.add_executable({ name: "hello", root: "src/main.zen" })
}
