// ============================================================================
// UNIFIED ALLOCATOR DEMONSTRATION
// ============================================================================
//
// The Problem (before):
//   - You had to write TWO versions of every function
//   - sync_fetch_data() for blocking code
//   - async_fetch_data() for async code
//   - This is called "function coloring" - a major pain in Rust, JavaScript, etc.
//
// The Solution (now):
//   - Write ONE function that takes an Allocator
//   - Pass Heap.sync() for blocking behavior
//   - Pass Arena.async() for async behavior
//   - Same code, different execution model!
//
// ============================================================================

{ io } = std
{ Heap } = std.memory.heap
{ Arena } = std.memory.arena
{ Allocator, ExecutionMode } = std.memory.allocator

// ============================================================================
// THE KEY FUNCTION: Works with ANY allocator!
// ============================================================================

demo_allocator = (alloc: Allocator) void {
    io.println("  Allocating 1024 bytes...")
    buffer = alloc.allocate(1024)

    mode = alloc.mode()
    mode ?
        | Sync { io.println("  Mode: SYNC (blocking I/O)") }
        | Async { io.println("  Mode: ASYNC (non-blocking I/O)") }

    compiler.store<i64>(buffer, 42)
    value = compiler.load<i64>(buffer)
    io.println("  Stored and read back: ${value}")

    alloc.deallocate(buffer, 1024)
    io.println("  Freed buffer")
}

// ============================================================================
// MAIN
// ============================================================================

main = () i32 {
    io.println("========================================")
    io.println("   UNIFIED ALLOCATOR DEMO")
    io.println("========================================")
    io.println("")

    io.println("--- Test 1: Heap.sync() ---")
    sync_alloc = Heap.sync()
    demo_allocator(sync_alloc)
    io.println("")

    io.println("--- Test 2: Arena.async() ---")
    async_alloc = Arena.async()
    demo_allocator(async_alloc)
    io.println("")

    io.println("========================================")
    io.println("   KEY INSIGHT")
    io.println("========================================")
    io.println("The SAME demo_allocator() function works with both!")
    io.println("- Heap.sync()   = blocking I/O")
    io.println("- Arena.async() = async I/O (io_uring)")
    io.println("")
    io.println("NO async/await! NO function coloring!")
    io.println("")

    0
}
