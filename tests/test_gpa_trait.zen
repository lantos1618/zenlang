// Test GPA trait methods
{ io } = @std
{ compiler } = @std
{ GPA } = @std.memory.gpa

main = () i32 {
    io.println("Testing GPA trait methods...")

    gpa = GPA { id: 0 }

    // Try to allocate via trait method
    ptr = gpa.allocate(64)

    io.println("Allocated 64 bytes")

    // Deallocate
    gpa.deallocate(ptr, 64)

    io.println("Deallocated")
    io.println("Success!")
    0
}
