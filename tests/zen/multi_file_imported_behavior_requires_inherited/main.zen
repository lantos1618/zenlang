{ io } = std
{ Json } = base
{ PrettyJson } = traits

Point: {
    x: i32
}

Point.implements(PrettyJson) {
    encode = (value: Point) StaticString {
        "inherited-required"
    }

    pretty = (value: Point) StaticString {
        "pretty"
    }
}

Point.requires(Json<StaticString>)

encode<T: Json<StaticString>> = (value: T) StaticString {
    value.encode()
}

main = () i32 {
    point = Point { x: 41 }
    io.println(encode(point))
    0
}
