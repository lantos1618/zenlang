{ io } = std

Point: {
    x: i32
}

Json<T>: behavior {
    encode: (Self) T
}

Point.implements(Json<Point>) {
    encode = (value: Point) Point {
        value
    }
}

identity<T: Json<T>> = (value: T) T {
    value
}

main = () i32 {
    point = Point { x: 7 }
    same = identity(point)
    io.println("${same.x}")
    0
}
