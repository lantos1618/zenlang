Option<T>:
    None,
    Some(T)

Option.unwrap_or<T> = (self: Self, fallback: T) T {
    self ?
        | Some(value) { value }
        | None { fallback }
}

Option.value_or<T> = (self: Self, fallback: T) T {
    self.unwrap_or<T>(fallback)
}

@export({ Option, Option.unwrap_or, Option.value_or })
