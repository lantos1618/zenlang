{ io } = std

Json<T>: behavior {
    encode: (Self) T
}

Box<T>: {
    value: T
}

Box<T>.implements(Json<StaticString>) {
    encode = (self: Box<T>) StaticString {
        "boxed"
    }
}

Box<T>.implements(Json<i32>) {
    encode = (self: Box<T>) i32 {
        42
    }
}

encode_str<T: Json<StaticString>> = (value: T) StaticString {
    value.encode()
}

encode_i32<T: Json<i32>> = (value: T) i32 {
    value.encode()
}

main = () i32 {
    bool_box = Box<bool> { value: true }
    int_box = Box<i32> { value: 7 }

    io.println(encode_str(bool_box))
    io.println("${encode_i32(int_box)}")
    0
}
