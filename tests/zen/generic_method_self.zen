{ io } = std

Box<T>: {
    value: T
}

Option<T>:
    None,
    Some(T)

Box.copy<T> = (self: Self) Self {
    return self
}

main = () i32 {
    box = Box<i32> { value: 42 }
    copied = box.copy()
    io.println("${copied.value}")
    nested = Box<Option<i32>> { value: Option<i32>.Some(7) }
    copied_nested = nested.copy()
    unwrapped = copied_nested.value ?
        | Some(value) { value }
        | None { 0 }
    io.println("${unwrapped}")
    return 0
}
