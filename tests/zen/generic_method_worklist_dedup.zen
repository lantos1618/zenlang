{ io } = std

Box<T>: {
    value: T
}

Box.inner<T> = (self: Box<T>) T {
    self.value
}

Box.left_inner<T> = (self: Box<T>) T {
    self.inner<T>()
}

Box.right_inner<T> = (self: Box<T>) T {
    self.inner<T>()
}

main = () i32 {
    box = Box<i32> { value: 21 }
    a = box.left_inner<i32>()
    b = box.right_inner<i32>()
    io.println("${a + b}")
    0
}
