// Drives the promoted std.memory.async_pool module: submit three i64 futures to
// a pool, then drain them all to a single total — proving a Vec<Future<i64>> and
// future-typed submit/drain signatures now type-check and run.
{ io } = std
{ pool, submit, drain } = std.memory.async_pool

work = @async (n: i32, delay: i32) i64 {
    v = @await pending_then_ready(delay, n)
    cast(v, i64)
}

main = () i32 {
    p0 = pool()
    p1 = submit(p0, work(5, 2))
    p2 = submit(p1, work(7, 0))
    p3 = submit(p2, work(9, 3))
    total = drain(p3)
    io.println("total = ${total}")
    0
}
