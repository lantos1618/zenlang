{ Option } = types

Box<T>: {
    value: T
}

Box.impl = {
    wrap<T> = (self: Box<T>) Option<T> {
        Option<T>.Some(self.value)
    }

    value_or<T> = (self: Box<T>, fallback: T) T {
        value = self.wrap<T>()
        value ?
            | Some(inner) { inner }
            | None { fallback }
    }
}

@export({ Box })
