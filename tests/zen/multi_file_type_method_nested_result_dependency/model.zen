{ Option, Result } = types

Box<T>: {
    value: T
}

Box.wrap_result<T> = (self: Box<T>) Result<Option<T>, StaticString> {
    Result<Option<T>, StaticString>.Ok(Option<T>.Some(self.value))
}

unwrap_option<T> = (value: Option<T>, fallback: T) T {
    value ?
        | Some(inner) { inner }
        | None { fallback }
}

unwrap_result<T, E> = (value: Result<T, E>, fallback: T) T {
    value ?
        | Ok(inner) { inner }
        | Err(_) { fallback }
}

@export({ Box, Box.wrap_result, unwrap_option, unwrap_result })
