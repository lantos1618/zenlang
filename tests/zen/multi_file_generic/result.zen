Option<T>:
    None,
    Some(T)

Result<T, E>:
    Ok(T),
    Err(E)

unwrap_option<T> = (value: Option<T>, fallback: T) T {
    value ?
        | Some(inner) { inner }
        | None { fallback }
}

unwrap_result<T, E> = (value: Result<T, E>, fallback: T) T {
    value ?
        | Ok(inner) { inner }
        | Err(_) { fallback }
}

@export({ Option, Result, unwrap_option, unwrap_result })
