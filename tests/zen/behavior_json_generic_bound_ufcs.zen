{ io } = std

Point: {
    x: i32
}

Json<T>: behavior {
    encode: (Self) T
}

Point.implements(Json<Point>) {
    encode = (value: Point) Point {
        return value
    }
}

encode<T: Json<T>> = (value: T) T {
    return value.encode()
}

main = () i32 {
    point = Point { x: 1 }
    encoded = encode(point)
    io.println("${encoded.x}")
    return 0
}
