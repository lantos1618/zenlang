{ io } = std

Json<T>: behavior {
    encode: (Self) T
}

Point: {
    x: i32
}

Point.implements(Json<StaticString>) {
    encode = (self: Point) StaticString {
        "point"
    }
}

Point.requires(Json<StaticString>)

main = () i32 {
    point = Point { x: 1 }
    io.println(point.encode())
    0
}
