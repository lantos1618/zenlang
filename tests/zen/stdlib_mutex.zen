// 4 threads x 1000 increments under a pthread mutex → counter == 4000.
// Thread arg is a pointer to a { mutex_ptr, counter_ptr } pair (16 bytes).
{ io } = std
{ Mutex, mutex_new, mutex_lock, mutex_unlock, mutex_destroy } = std.concurrency.sync.mutex

@extern pthread_create = (thread: RawPtr<u8>, attr: RawPtr<u8>, start: (RawPtr<u8>) RawPtr<u8>, arg: RawPtr<u8>) i32
@extern pthread_join = (thread: i64, retval: RawPtr<u8>) i32
@extern pthread_mutex_lock = (mutex: RawPtr<u8>) i32
@extern pthread_mutex_unlock = (mutex: RawPtr<u8>) i32

// Thread worker: reads mutex_ptr and counter_ptr from the 16-byte arg block,
// then does 1000 locked increments.
worker = (arg: RawPtr<u8>) RawPtr<u8> {
    mutex_ptr = @builtin.load<RawPtr<u8>>(arg)
    counter_ptr = @builtin.load<RawPtr<u8>>(@builtin.gep(arg, 8))
    i ::= cast(0, i64)
    loop((l) {
        i < 1000 ?
            | true {
                pthread_mutex_lock(mutex_ptr)
                cur = @builtin.load<i64>(counter_ptr)
                @builtin.store(counter_ptr, cur + 1)
                pthread_mutex_unlock(mutex_ptr)
                i = i + 1
                l.next()
            }
            | false { l.done() }
    })
    @builtin.null_ptr()
}

main = () i32 {
    m = mutex_new()

    // Shared counter cell (8 bytes, initialised to 0)
    counter = @builtin.raw_allocate(cast(8, usize))
    @builtin.store(counter, cast(0, i64))

    // Arg block: [mutex_ptr (8 bytes), counter_ptr (8 bytes)]
    arg_block = @builtin.raw_allocate(cast(16, usize))
    @builtin.store(arg_block, m.ptr)
    @builtin.store(@builtin.gep(arg_block, 8), counter)

    // Allocate thread id storage (4 × 8 bytes)
    threads = @builtin.raw_allocate(cast(32, usize))

    i ::= cast(0, i64)
    loop((l) {
        i < 4 ?
            | true {
                slot = @builtin.gep(threads, i * 8)
                pthread_create(slot, @builtin.null_ptr(), worker, arg_block)
                i = i + 1
                l.next()
            }
            | false { l.done() }
    })

    j ::= cast(0, i64)
    loop((l) {
        j < 4 ?
            | true {
                slot = @builtin.gep(threads, j * 8)
                tid = @builtin.load<i64>(slot)
                pthread_join(tid, @builtin.null_ptr())
                j = j + 1
                l.next()
            }
            | false { l.done() }
    })

    result = @builtin.load<i64>(counter)
    io.println("counter=${cast(result, i32)}")

    @builtin.raw_deallocate(threads, cast(32, usize))
    @builtin.raw_deallocate(arg_block, cast(16, usize))
    @builtin.raw_deallocate(counter, cast(8, usize))
    mutex_destroy(m)
    0
}
