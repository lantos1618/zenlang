{ io } = std
{ PrettyJson } = traits

Point: {
    x: i32
}

Point.implements(PrettyJson) {
    encode = (value: Point) StaticString {
        "encoded"
    }

    pretty = (value: Point) StaticString {
        "pretty"
    }
}

render<T: PrettyJson> = (value: T) StaticString {
    value.encode()
}

main = () i32 {
    point = Point { x: 31 }
    io.println(render(point))
    io.println(point.pretty())
    0
}
