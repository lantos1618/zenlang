{ io } = std

Point: {
    x: i32
}

Json<T>: behavior {
    encode: (Self) T
}

Point.implements(Json<str>) {
    encode = (value: Point) str {
        "point"
    }
}

Point.implements(Json<i32>) {
    encode = (value: Point) i32 {
        value.x
    }
}

encode_str<T: Json<str>> = (value: T) str {
    value.encode()
}

encode_i32<T: Json<i32>> = (value: T) i32 {
    value.encode()
}

main = () i32 {
    point = Point { x: 42 }
    io.println(encode_str(point))
    io.println("${encode_i32(point)}")
    0
}
