// Drives the promoted std.concurrency.async.scheduler module: build a scheduler,
// spawn three @async tasks that suspend a different number of times, and run them
// cooperatively to completion. Each task folds its value into a shared cell, so
// the totals prove every spawned task ran.
{ io } = std
{ scheduler, spawn, run } = std.concurrency.async.scheduler

task = @async (cell: RawPtr<u8>, delay: i32, value: i32) i32 {
    v = @await pending_then_ready(delay, value)
    sum = @builtin.load<i64>(cell)
    @builtin.store(cell, sum + cast(v, i64))
    done = @builtin.load<i64>(@builtin.gep(cell, 8))
    @builtin.store(@builtin.gep(cell, 8), done + cast(1, i64))
    v
}

main = () i32 {
    cell = @builtin.raw_allocate(cast(24, usize))
    @builtin.store(cell, cast(0, i64))
    @builtin.store(@builtin.gep(cell, 8), cast(0, i64))

    s0 = scheduler()
    s1 = spawn(s0, task(cell, 2, 5))
    s2 = spawn(s1, task(cell, 0, 7))
    s3 = spawn(s2, task(cell, 4, 9))
    run(s3)

    sum = @builtin.load<i64>(cell)
    done = @builtin.load<i64>(@builtin.gep(cell, 8))
    io.println("sum = ${sum}")
    io.println("done = ${done}")
    0
}
