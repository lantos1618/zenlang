// Test HeapSync allocator
{ io } = @std
{ Heap, HeapSync } = @std.memory.heap
{ ExecutionMode } = @std.memory.allocator

main = () i32 {
    io.println("Testing HeapSync allocator...")

    // Create allocator via factory
    alloc = Heap.sync()

    // Test memory allocation
    ptr = alloc.allocate(64)
    io.println("Allocated 64 bytes")

    // Test mode
    mode = alloc.mode()
    mode ?
        | Sync { io.println("Mode: Sync (correct!)") }
        | Async { io.println("Mode: Async (wrong!)") }

    // Test deallocation
    alloc.deallocate(ptr, 64)
    io.println("Deallocated")

    // Test poll/wait (should be no-ops)
    poll_result = alloc.poll()
    io.println("Poll returned: ${poll_result}")

    wait_result = alloc.wait()
    io.println("Wait returned: ${wait_result}")

    io.println("HeapSync test passed!")
    return 0
}
